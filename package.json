{
  "name": "hrk-design-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node scripts/check-data.mjs",
    "check:builds": "node scripts/check-brand-builds.mjs",
    "build": "node scripts/check-data.mjs && vite build",
    "build:hrk": "npm run build",
    "build:cijd": "node scripts/check-data.mjs && VITE_BRAND=cijd vite build --outDir dist-cijd",
    "preview": "vite preview"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "qrcode": "^1.5.3"
  }
}
